<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation|null $site
 * @var bool $gscConfigured
 * @var bool $jsonLdEnabled
 * @var bool $citationEnabled
 * @var bool $sitemapEnabled
 * @var bool $noindexSite
 * @var bool $pingEnabled
 * @var string $indexNowKey
 * @var bool $indexNowKeyValid
 * @var array{pending:int,failed:int}|null $queueCounts
 * @var string $sitemapUrl
 * @var string $robotsUrl
 * @var array{items:int,itemSets:int,pages:int} $counts
 * @var list<array{id:int,label:string,items:int,missing:list<string>}>|null $unmappedTemplates
 * @var \Laminas\Form\Form $confirmForm
 */

$this->headLink()->appendStylesheet($this->assetUrl('css/admin.css', 'DRESeo'));
$on = '<span class="dre-seo-on">' . $this->translate('On') . '</span>';
$off = '<span class="dre-seo-off">' . $this->translate('Off') . '</span>';
$configureUrl = $this->url('admin/default', ['controller' => 'module', 'action' => 'configure'], ['query' => ['id' => 'DRESeo']]);
?>
<?php echo $this->pageTitle($this->translate('SEO'), 1); ?>

<div class="active section" role="tabpanel">

    <?php if ($noindexSite): ?>
    <p class="messages"><span class="message warning"><?php echo $this->translate('Site-wide “discourage indexing” is ON — every page is marked noindex and robots.txt disallows everything. Turn it off in Configure for production.'); ?></span></p>
    <?php endif; ?>

    <h2><?php echo $this->translate('Status'); ?></h2>
    <table class="tablesaw" data-tablesaw-mode="stack">
        <thead>
            <tr>
                <th><?php echo $this->translate('Feature'); ?></th>
                <th><?php echo $this->translate('State'); ?></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><?php echo $this->translate('Google Search Console verification'); ?></td>
                <td><?php echo $gscConfigured ? $on : $off; ?>
                    <?php if (!$gscConfigured): ?>
                        — <a href="<?php echo $this->escapeHtmlAttr($configureUrl); ?>"><?php echo $this->translate('paste your snippet in Configure'); ?></a>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <td><?php echo $this->translate('schema.org JSON-LD'); ?></td>
                <td><?php echo $jsonLdEnabled ? $on : $off; ?></td>
            </tr>
            <tr>
                <td><?php echo $this->translate('Citation tags (Zotero / Scholar)'); ?></td>
                <td><?php echo $citationEnabled ? $on : $off; ?></td>
            </tr>
            <tr>
                <td><?php echo $this->translate('XML sitemap & robots.txt'); ?></td>
                <td><?php echo $sitemapEnabled ? $on : $off; ?></td>
            </tr>
            <tr>
                <td><?php echo $this->translate('IndexNow ping'); ?></td>
                <td>
                    <?php echo $pingEnabled ? $on : $off; ?>
                    <?php if ($pingEnabled && $indexNowKey === ''): ?>
                        — <span class="dre-seo-off"><?php echo $this->translate('no key set'); ?></span>
                    <?php elseif (!$indexNowKeyValid): ?>
                        — <span class="dre-seo-off"><?php echo $this->translate('the key is not 8–128 hexadecimal characters, so /{key}.txt cannot be served and nothing is sent'); ?></span>
                    <?php endif; ?>
                </td>
            </tr>
        </tbody>
    </table>

    <?php if ($queueCounts !== null && ($pingEnabled || $queueCounts['pending'] + $queueCounts['failed'] > 0)): ?>
    <p><?php echo $this->escapeHtml(sprintf(
        $this->translate('IndexNow queue: %1$s pending; %2$s failed (refused, or out of retries).'),
        number_format($queueCounts['pending']),
        number_format($queueCounts['failed'])
    )); ?></p>
        <?php if ($queueCounts['failed'] > 0): ?>
    <p><?php echo $this->translate('Failed URLs are not resent. Once the cause is fixed (the key, the host), re-queue them by running scripts/drain-indexnow.php --retry-failed on the server; the job log says what IndexNow answered.'); ?></p>
        <?php endif; ?>
    <?php endif; ?>

    <?php if ($unmappedTemplates !== null): ?>
    <h2><?php echo $this->escapeHtml($this->translate('Resource templates')); ?></h2>
        <?php if ($unmappedTemplates === []): ?>
    <p><?php echo $this->escapeHtml($this->translate('Every resource template in use has a schema.org type and a citation kind.')); ?></p>
        <?php else: ?>
    <p class="messages"><span class="message warning"><?php echo $this->escapeHtml($this->translate('These resource templates are in use but missing from the template maps in config/instance.config.php, so their items are described as a generic CreativeWork or cited as a generic document. Add them to structured_data.template_types and citation.template_kinds.')); ?></span></p>
    <ul class="dre-seo-templates">
            <?php foreach ($unmappedTemplates as $template): ?>
        <li><?php echo $this->escapeHtml(sprintf(
            $this->translate('Template %1$s (%2$s): %3$s items; no %4$s'),
            $template['id'],
            $template['label'] !== '' ? $template['label'] : $this->translate('no label'),
            number_format($template['items']),
            implode(', ', array_map(
                fn (string $map): string => $map === 'schema.org type'
                    ? $this->translate('schema.org type')
                    : $this->translate('citation kind'),
                $template['missing']
            ))
        )); ?></li>
            <?php endforeach; ?>
    </ul>
        <?php endif; ?>
    <?php endif; ?>

    <?php if ($sitemapEnabled && $sitemapUrl): ?>
    <h2><?php echo $this->translate('Sitemap'); ?></h2>
    <ul class="dre-seo-links">
        <li>
            <a href="<?php echo $this->escapeHtmlAttr($sitemapUrl); ?>" target="_blank" rel="noopener">
                <?php echo $this->escapeHtml($sitemapUrl); ?>
            </a>
        </li>
        <li>
            <a href="<?php echo $this->escapeHtmlAttr($robotsUrl); ?>" target="_blank" rel="noopener">
                <?php echo $this->escapeHtml($robotsUrl); ?>
            </a>
        </li>
    </ul>
    <p>
        <?php echo sprintf(
            $this->translate('Covering %1$s public items, %2$s item sets and %3$s pages.'),
            '<strong>' . number_format($counts['items']) . '</strong>',
            '<strong>' . number_format($counts['itemSets']) . '</strong>',
            '<strong>' . number_format($counts['pages']) . '</strong>'
        ); ?>
    </p>
    <p><?php echo $this->translate('The sitemap is cached, and saving, editing or deleting a record, page, media or site clears the cache. Clear it by hand after a change that bypasses Omeka (a database import, say), or after editing config/local.config.php.'); ?></p>
    <?php
    $confirmForm->setAttribute('action', $this->url('admin/dre-seo/regenerate'));
    echo $this->form($confirmForm);
    ?>
    <?php endif; ?>

    <h2><?php echo $this->translate('Static pages'); ?></h2>
    <p>
        <a class="button" href="<?php echo $this->escapeHtmlAttr($this->url('admin/dre-seo/pages')); ?>">
            <?php echo $this->translate('Edit per-page SEO'); ?>
        </a>
        <a class="button" href="<?php echo $this->escapeHtmlAttr($configureUrl); ?>">
            <?php echo $this->translate('Configure defaults & verification'); ?>
        </a>
    </p>
</div>
