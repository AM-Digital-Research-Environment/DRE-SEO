<?php

/**
 * Type stubs for the Omeka S and Laminas supertypes this module extends or
 * implements, for the unit-suite pass of PHPStan (phpstan.unit.neon.dist).
 *
 * That pass analyses the tests against tests/Shim/omeka.php, not Omeka, and
 * reads the module's own classes for their symbols; without these supertypes
 * the classes those tests exercise would extend unknown classes. The module
 * itself is analysed against the real Omeka tree (phpstan.neon.dist), which
 * needs none of this.
 *
 * Deliberately memberless, bar AbstractJob's constructor (see there). The
 * point is to make the inheritance resolvable, not to re-describe Omeka's API
 * — a stub that guessed at signatures would invent errors rather than remove
 * them. The representation, settings and DBAL classes come from the shim
 * instead, which PHPStan executes.
 *
 * Not a runtime file: unlike tests/Shim/omeka.php (which is executed, and
 * gives the classes the unit suite instantiates real bodies), this is only
 * ever parsed by PHPStan. Hence the .stub extension — which also keeps it out
 * of the CI `php -l` sweep and phpcs, both of which only look at .php.
 *
 * Wired in through `scanFiles`, not `stubFiles`, despite the extension:
 * PHPStan's stub mechanism only overrides the PHPDoc of symbols that already
 * exist and cannot introduce a class it has never seen. scanFiles is the
 * symbol-discovery path for code outside Composer's autoloader.
 */

namespace Omeka\Module {
    abstract class AbstractModule
    {
    }
}

namespace Omeka\Job {
    abstract class AbstractJob
    {
        /**
         * The one member stubbed, copied from Omeka 4.2.1 rather than
         * guessed: without it, the integration test that runs the IndexNow
         * job directly reads as instantiating a constructor-less class.
         */
        public function __construct(\Omeka\Entity\Job $job, \Laminas\ServiceManager\ServiceLocatorInterface $serviceLocator)
        {
        }
    }
}

namespace Laminas\Mvc\Controller {
    abstract class AbstractActionController
    {
    }
}

namespace Laminas\Form {
    class Form
    {
    }
}

namespace Laminas\View\Helper {
    abstract class AbstractHelper
    {
    }
}

namespace Laminas\ServiceManager\Factory {
    interface FactoryInterface
    {
    }
}
