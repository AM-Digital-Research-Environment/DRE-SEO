; Africa Multiple — DRE SEO
; Copied from DRE-theme's .editorconfig, so the repositories share one baseline
; (UTF-8, LF, final newline, no trailing whitespace, spaces). Only the sections
; below the baseline differ, and each records this tree's existing convention
; rather than a new one: PHP, the view scripts, asset/css and phpstan.neon.dist
; use four spaces; composer.json, the workflows and CITATION.cff use two. The
; PHPStan baseline is generated, with tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{scss,css}]
indent_size = 4

[*.{json,yml,yaml,cff,neon}]
indent_size = 2

[*.md]
; Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.ini]
indent_style = space
indent_size = 4

[*.{po,pot}]
; Gettext catalogues are generated; leave them exactly as written.
trim_trailing_whitespace = false
insert_final_newline = false
