# The module, analysed against the real Omeka S tree. One of two passes;
# phpstan.unit.neon.dist is the other, for the unit suite. `composer analyse`
# runs both, and needs OMEKA_PATH, as the integration suite does.
#
# Everything used to be analysed against tests/Shim/omeka.php and a
# memberless stub of the Omeka and Laminas supertypes, so the boundary was
# opaque and class.notFound, method.notFound and argument.type were ignored
# globally — the last of which would also have masked a genuine mismatch
# between two of the module's own classes. Here PHPStan loads Omeka's own
# autoloader (through the integration suite's bootstrap) and reads the classes
# production runs: nothing is ignored by identifier.
#
# The unit suite cannot join this pass. Its tests build the shim's
# representations (an ItemRepresentation from an array of values, a
# ValueRepresentation from a string), whose constructors are not Omeka's, so
# against the real classes every one of them is an argument error. It is
# analysed against the shim, which is what it runs against.
#
# Findings that predate analysis being enforced are recorded in
# phpstan-baseline.neon rather than fixed, in four groups.
#   - Methods with no return type, or a narrower one than Laminas' PHPDoc,
#     each overriding an untyped Omeka or Laminas method (Module::
#     getConfigForm(), handleConfigForm(), two admin actions, and two
#     indexAction()s that answer a Response where Laminas documents a
#     ViewModel). Changing the type is a signature change, not a fix.
#   - Defensive checks PHPStan proves redundant against the Omeka 4.2.1
#     classes: method_exists() guards on Omeka representations, and a label
#     fallback in the citation helper. Removing them changes what an older
#     Omeka or a future format does, which is a behaviour change.
#   - Two vacuous assertions in CitationDataTest (the unit pass), kept from
#     the old harness: build() cannot return null, so the `!== null` checks
#     always pass.
#
# The point is the ratchet — level 6 applies in full to new and changed code,
# while the standing debt stays visible and shrinkable. It is a ledger, not a
# suppression list: delete entries as they are fixed, and never regenerate it
# wholesale to make a new error disappear. Both passes include it, and an
# entry the pass does not reach is not reported (reportUnmatchedIgnoredErrors).
#
# Regenerating is a deliberate act. With the baseline in `includes`, its own
# entries are already suppressed during analysis, so
# `vendor/bin/phpstan analyse --generate-baseline=phpstan-baseline.neon`
# run as is would write a baseline covering only the *new* errors and
# silently drop the recorded debt. Comment the include out first, run both
# passes, and read the diff.
includes:
    - phpstan-baseline.neon

parameters:
    level: 6

    paths:
        - Module.php
        - scripts
        - src
        - tests/Integration

    # Puts Omeka's vendor and application classes on the autoloader, ahead of
    # the module's development-only vendor, and fails when OMEKA_PATH does not
    # name an Omeka tree. The shim is not loaded, and not in `paths`: PHPStan
    # would read its declarations before the real ones.
    bootstrapFiles:
        - tests/Integration/bootstrap.php

    ignoreErrors:
        # PhpRenderer dispatches every view helper ($view->translate(),
        # $view->currentSite(), …) through __call(), so no helper is a method
        # PHPStan can see. Only the renderer's: a missing method on any other
        # class still reports.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Laminas\\View\\Renderer\\PhpRenderer\:\:[A-Za-z]+\(\)\.$#'

        # The same for controllers: AbstractController dispatches its plugins
        # through __call(). Named one by one, so a typo in a controller's own
        # method still reports.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method [A-Za-z\\]+Controller\:\:(messenger|getForm)\(\)\.$#'

        # ResourceValueReader is a trait, and PHPStan checks a private
        # constant's use per *using* class: DATE_TERMS, DESCRIPTION_TERMS and
        # EDITOR_TERMS are reported unused against each of its users that does
        # not read them. CitationData reads all three — deleting one on this
        # report's say-so would break it.
        -
            identifier: classConstant.unused
            message: '#^Constant DRESeo\\Service\\[A-Za-z]+\:\:(DATE|DESCRIPTION|EDITOR)_TERMS is unused\.$#'

    reportUnmatchedIgnoredErrors: false

    treatPhpDocTypesAsCertain: false
