# Normalise line endings to LF in the repository (cross-platform consistency).
* text=auto eol=lf

# Binary assets — never normalise.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.mo   binary

# Language stats: .phtml files are Omeka S view templates, i.e. PHP — not HTML.
*.phtml linguist-language=PHP

# ---------------------------------------------------------------------------
# Release archive contents
#
# `git archive --prefix=DRESeo/` (see .github/workflows/release.yml) builds the
# installable module zip and honours every `export-ignore` below. What ships is
# exactly what Omeka needs at runtime — Module.php, config/, src/, view/, asset/,
# language/, composer.json — plus README, LICENSE and CHANGELOG for whoever
# unpacks it. Everything else is repository furniture and stays out.
#
# Consequence worth knowing: `composer check` / `composer test` do NOT run inside
# an unpacked release, because tests/ and the tool configurations are excluded by
# design. Run them from a clone. Some entries name files that do not exist yet;
# they cost nothing and keep a new one from leaking the day it is added.
# ---------------------------------------------------------------------------
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.editorconfig   export-ignore
/.github         export-ignore
/tests           export-ignore
/phpcs.xml.dist  export-ignore
/phpunit.xml.dist export-ignore
/phpunit.integration.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpstan-baseline.neon export-ignore
/CITATION.cff    export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md     export-ignore
/CLAUDE.md       export-ignore
